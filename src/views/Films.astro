---
// Katalog film, dipakai oleh /films/ dan /id/tontonan/.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PosterCard from '../components/PosterCard.astro';
import LogRow from '../components/LogRow.astro';
import { filmsByDate, filmCount, type Film } from '../lib/data';
import { langOf, otherLang, routes, useTranslations } from '../i18n/ui';

const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);
const all = filmsByDate();

// Kelompokkan per tahun ditonton; film tanpa tanggal di kelompok terakhir.
const groups = new Map<string, Film[]>();
for (const film of all) {
  const key = film.watchedDate?.slice(0, 4) ?? 'none';
  groups.set(key, [...(groups.get(key) ?? []), film]);
}
---

<BaseLayout
  title={t('filmsPage.title')}
  description={t('filmsPage.description')}
  alternate={routes.films[otherLang(lang)]}
>
  <PageIntro
    label={t('filmsPage.title')}
    title={t('filmsPage.heading')}
    meta={t('filmsPage.meta', { n: filmCount() })}
  />

  <div class="container views">
    <!-- Tampilan dipilih lewat anchor (#tabel), tanpa JavaScript -->
    <nav class="view-switch label" aria-label={t('filmsPage.views')}>
      <a href="#grid" class="to-grid">{t('filmsPage.grid')}</a>
      <span aria-hidden="true">/</span>
      <a href="#tabel" class="to-table">{t('filmsPage.table')}</a>
    </nav>

    <div id="grid" class="grid-view">
      {
        [...groups].map(([year, films], g) => (
          <section class="section group" aria-labelledby={`tahun-${year}`}>
            <h2 class="label" id={`tahun-${year}`}>
              {t('filmsPage.group', {
                year: year === 'none' ? t('date.none') : year,
                n: films.length,
              })}
            </h2>
            <div class="poster-grid">
              {films.map((film, i) => (
                <PosterCard
                  title={film.title}
                  year={film.year}
                  director={film.director}
                  rating={film.rating}
                  href={film.letterboxdUrl}
                  poster={film.poster}
                  index={i}
                  priority={g === 0 && i < 2}
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section id="tabel" class="table-view" aria-label={t('filmsPage.tableLabel')}>
      <ul class="plain-list">
        {
          all.map((film) => (
            <LogRow
              date={film.watchedDate}
              title={film.title}
              year={film.year}
              rating={film.rating}
              href={film.letterboxdUrl}
            />
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .view-switch {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .view-switch a {
    color: var(--accent);
    text-decoration: none;
  }

  .view-switch a:hover {
    text-decoration: underline;
  }

  .group h2 {
    margin-bottom: 32px;
  }

  .table-view {
    display: none;
    border-top: 1px solid var(--ink);
  }

  /* #tabel aktif: tampilkan tabel, sembunyikan grid */
  .table-view:target {
    display: block;
    scroll-margin-top: 120px;
  }

  .views:has(.table-view:target) .grid-view {
    display: none;
  }

  /* Tandai pilihan yang sedang aktif */
  .views:not(:has(.table-view:target)) .to-grid,
  .views:has(.table-view:target) .to-table {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
