---
// Satu catatan, dipakai oleh /catatan/[slug]/ dan /en/notes/[slug]/.
// Teks antarmuka mengikuti bahasa halaman; isi catatan diberi `lang` sesuai bahasanya sendiri.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isoDate, type Note } from '../lib/data';
import { langOf, otherLang, routes, notePath, useTranslations } from '../i18n/ui';

interface Props {
  note: Note;
  translation?: Note;
}

const { note, translation } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);
const { Content } = await render(note);
const { title, date, summary, draft } = note.data;
const noteLang = note.data.lang;
---

<BaseLayout title={title} description={summary} alternate={notePath(otherLang(lang), note.id)}>
  <article class="container note">
    <p class="label meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span>{noteLang.toUpperCase()}</span>
      {draft && <span>{t('draft')}</span>}
    </p>
    <h1 lang={noteLang}>{title}</h1>
    {
      translation && (
        <p class="label translation">
          <a href={notePath(lang, translation.id)} lang={translation.data.lang}>
            {t(`note.readIn.${translation.data.lang}`)} <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
    <div class="body" lang={noteLang}>
      <Content />
    </div>
    <p class="label back">
      <a href={routes.notes[lang]}><span aria-hidden="true">←</span> {t('note.back')}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .note {
    max-width: calc(680px + 2 * var(--gutter));
    padding-block: 48px 24px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  h1 {
    margin-top: 20px;
    font-size: var(--fs-h2);
    line-height: 1.12;
  }

  .translation {
    margin-top: 16px;
  }

  .label a {
    color: var(--accent);
    text-decoration: none;
  }

  .label a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .body {
    margin-top: 40px;
    font-size: 20px;
    line-height: 1.65;
  }

  .body :global(p + p),
  .body :global(* + h2),
  .body :global(* + ul),
  .body :global(* + ol),
  .body :global(* + blockquote) {
    margin-top: 1.1em;
  }

  .body :global(h2) {
    font-size: var(--fs-card);
  }

  .body :global(blockquote) {
    margin-inline: 0;
    padding-left: 20px;
    border-left: 1px solid var(--rule);
    font-style: italic;
    color: var(--ink-2);
  }

  .back {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
</style>
