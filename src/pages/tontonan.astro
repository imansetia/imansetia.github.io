---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PosterCard from '../components/PosterCard.astro';
import LogRow from '../components/LogRow.astro';
import { filmsByDate, filmCount, type Film } from '../lib/data';

const all = filmsByDate();

// Kelompokkan per tahun ditonton; film tanpa tanggal di kelompok terakhir.
const groups = new Map<string, Film[]>();
for (const film of all) {
  const key = film.watchedDate?.slice(0, 4) ?? 'Tanpa tanggal';
  groups.set(key, [...(groups.get(key) ?? []), film]);
}
---

<BaseLayout title="Tontonan" description="Katalog film yang ditonton Iman Setia, disinkronkan dari Letterboxd.">
  <PageIntro label="Tontonan" title="Film yang saya tonton" meta={`${filmCount()} film tercatat · sumber: Letterboxd`} />

  <div class="container views">
    <!-- Tampilan dipilih lewat anchor (#tabel), tanpa JavaScript -->
    <nav class="view-switch label" aria-label="Pilih tampilan">
      <a href="#grid" class="to-grid">Grid</a>
      <span aria-hidden="true">/</span>
      <a href="#tabel" class="to-table">Tabel</a>
    </nav>

    <div id="grid" class="grid-view">
      {
        [...groups].map(([year, films]) => (
          <section class="section group" aria-labelledby={`tahun-${year}`}>
            <h2 class="label" id={`tahun-${year}`}>
              {year} · {films.length} film
            </h2>
            <div class="poster-grid">
              {films.map((film, i) => (
                <PosterCard
                  title={film.title}
                  year={film.year}
                  director={film.director}
                  rating={film.rating}
                  href={film.letterboxdUrl}
                  poster={film.poster}
                  index={i}
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section id="tabel" class="table-view" aria-label="Semua film dalam tabel">
      <ul class="plain-list">
        {
          all.map((film) => (
            <LogRow
              date={film.watchedDate}
              title={film.title}
              year={film.year}
              rating={film.rating}
              href={film.letterboxdUrl}
            />
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .view-switch {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .view-switch a {
    color: var(--accent);
    text-decoration: none;
  }

  .view-switch a:hover {
    text-decoration: underline;
  }

  .group h2 {
    margin-bottom: 32px;
  }

  .table-view {
    display: none;
    border-top: 1px solid var(--ink);
  }

  /* #tabel aktif: tampilkan tabel, sembunyikan grid */
  .table-view:target {
    display: block;
    scroll-margin-top: 120px;
  }

  .views:has(.table-view:target) .grid-view {
    display: none;
  }

  /* Tandai pilihan yang sedang aktif */
  .views:not(:has(.table-view:target)) .to-grid,
  .views:has(.table-view:target) .to-table {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
