---
// Kerangka halaman Tentang. Teks berkurung siku [ ... ] ditulis Iman (DESIGN.md bagian 8 & 11).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<BaseLayout title="Tentang" description="Tentang Iman Setia Halawa, mahasiswa hukum di Universitas Sumatera Utara.">
  <PageIntro label="Tentang" title="Tentang saya" />

  <div class="container about">
    <section class="section" aria-labelledby="bio">
      <h2 class="label" id="bio">Bio</h2>
      <div class="text">
        <p>[BIO — beberapa kalimat tentang diri Iman, ditulis sendiri oleh Iman.]</p>
      </div>
    </section>

    <section class="section" aria-labelledby="pendidikan">
      <h2 class="label" id="pendidikan">Pendidikan</h2>
      <dl class="text facts">
        <dt>S-1 Ilmu Hukum</dt>
        <dd>Universitas Sumatera Utara, Medan · [TAHUN MASUK]</dd>
      </dl>
    </section>

    <section class="section" aria-labelledby="minat">
      <h2 class="label" id="minat">Minat</h2>
      <div class="text">
        <p>Hukum, film, buku, dan teknologi.</p>
        <p>[Kalimat tambahan tentang minat, opsional.]</p>
        <p>
          Eksperimen teknologi saya ada di <a href="https://botchan.tech">botchan.tech</a>.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="kontak">
      <h2 class="label" id="kontak">Kontak</h2>
      <div class="text">
        <p><a href="mailto:imansetiahalawa@gmail.com">imansetiahalawa@gmail.com</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about .section {
    display: grid;
    grid-template-columns: 200px minmax(0, 680px);
    gap: 12px 24px;
    padding-bottom: 48px;
  }

  .text p + p {
    margin-top: 0.9em;
  }

  .facts {
    margin: 0;
  }

  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .about .section {
      grid-template-columns: 1fr;
    }
  }
</style>
