---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notesByDate, formatDate, isoDate } from '../../lib/data';

export async function getStaticPaths() {
  const notes = await notesByDate();
  return notes.map((note) => {
    // Terjemahan: catatan yang ditunjuk `translationOf`, atau yang menunjuk ke catatan ini.
    const translation = notes.find(
      (other) =>
        other.id !== note.id &&
        (other.id === note.data.translationOf || other.data.translationOf === note.id)
    );
    return { params: { slug: note.id }, props: { note, translation } };
  });
}

const { note, translation } = Astro.props;
const { Content } = await render(note);
const { title, date, lang, summary, draft } = note.data;
---

<BaseLayout title={title} description={summary}>
  <article class="container note" lang={lang}>
    <p class="label meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span>{lang.toUpperCase()}</span>
      {draft && <span>Draft</span>}
    </p>
    <h1>{title}</h1>
    {
      translation && (
        <p class="label translation" lang="id">
          <a href={`/catatan/${translation.id}/`} lang={translation.data.lang}>
            {translation.data.lang === 'en' ? 'Read in English' : 'Baca dalam bahasa Indonesia'}{' '}
            <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
    <div class="body">
      <Content />
    </div>
    <p class="label back" lang="id">
      <a href="/catatan/"><span aria-hidden="true">←</span> Kembali ke arsip catatan</a>
    </p>
  </article>
</BaseLayout>

<style>
  .note {
    max-width: calc(680px + 2 * var(--gutter));
    padding-block: 48px 24px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  h1 {
    margin-top: 20px;
    font-size: var(--fs-h2);
    line-height: 1.12;
  }

  .translation {
    margin-top: 16px;
  }

  .label a {
    color: var(--accent);
    text-decoration: none;
  }

  .label a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .body {
    margin-top: 40px;
    font-size: 20px;
    line-height: 1.65;
  }

  .body :global(p + p),
  .body :global(* + h2),
  .body :global(* + ul),
  .body :global(* + ol),
  .body :global(* + blockquote) {
    margin-top: 1.1em;
  }

  .body :global(h2) {
    font-size: var(--fs-card);
  }

  .body :global(blockquote) {
    margin-inline: 0;
    padding-left: 20px;
    border-left: 1px solid var(--rule);
    font-style: italic;
    color: var(--ink-2);
  }

  .back {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
</style>
