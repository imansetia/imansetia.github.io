---
import Poster from './Poster.astro';
import Rating from './Rating.astro';

interface Props {
  title: string;
  year: number;
  director?: string;
  rating?: number | null;
  href: string;
  poster?: string;
  index: number;
  priority?: boolean;
}

const { title, year, director, rating, href, poster, index, priority } = Astro.props;
---

<article class="poster-card">
  <a href={href} class="cover-link">
    <Poster src={poster} title={title} year={year} index={index} priority={priority} />
  </a>
  <h3 class="title"><a href={href}><em>{title}</em></a></h3>
  <p class="meta">{director ? `${director}, ${year}` : year}</p>
  <Rating value={rating} />
</article>

<style>
  .poster-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .cover-link {
    display: block;
    margin-bottom: 4px;
    text-decoration: none;
  }

  .title {
    font-size: 20px;
    line-height: 1.25;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .meta {
    font-size: 16px;
    line-height: 1.35;
    color: var(--ink-2);
  }
</style>
