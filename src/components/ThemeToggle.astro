---
// Tombol ganti tema terang/gelap. Pilihan disimpan di localStorage.
import { langOf, useTranslations } from '../i18n/ui';

const t = useTranslations(langOf(Astro.currentLocale));
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-dark={t('theme.toDark')}
  data-label-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const dark = window.matchMedia('(prefers-color-scheme: dark)');

  function currentTheme() {
    const set = root.dataset.theme;
    if (set === 'light' || set === 'dark') return set;
    return dark.matches ? 'dark' : 'light';
  }

  function updateLabel(button: HTMLButtonElement) {
    const label = currentTheme() === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
    if (label) button.setAttribute('aria-label', label);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    updateLabel(button);
    dark.addEventListener('change', () => updateLabel(button));

    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      updateLabel(button);
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  /* Terang: tampilkan bulan (ajakan ke gelap). Gelap: tampilkan matahari. */
  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>
