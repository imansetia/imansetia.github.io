---
import { langOf, useTranslations } from '../i18n/ui';

const t = useTranslations(langOf(Astro.currentLocale));
const [beforeTmdb, afterTmdb] = t('footer.tmdb').split('{tmdb}');
const year = new Date().getFullYear();

const links = [
  { href: 'mailto:imansetiahalawa@gmail.com', label: 'Email' },
  { href: 'https://github.com/imansetia', label: 'GitHub' },
  { href: 'https://letterboxd.com/solsticebay/', label: 'Letterboxd' },
  { href: 'https://www.goodreads.com/user/show/201369776', label: 'Goodreads' },
];
---

<footer class="site-footer">
  <div class="container inner">
    <p class="label">© {year} Iman Setia Halawa</p>
    <ul>
      {
        links.map((link) => (
          <li>
            <a class="label" href={link.href} rel="me">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- Atribusi wajib dari syarat penggunaan API TMDB -->
    <p class="credit">
      {beforeTmdb}<a href="https://www.themoviedb.org/">TMDB</a>{afterTmdb}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ink);
    margin-top: 48px;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 24px 40px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0;
    list-style: none;
  }

  a.label {
    color: var(--accent);
    text-decoration: none;
  }

  .credit {
    flex-basis: 100%;
    max-width: 680px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .credit a {
    color: inherit;
  }

  a.label:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
</style>
