---
// Baris kepala seksi: label "0N / NAMA" di kiri, link atau keterangan di kanan.
interface Props {
  label: string;
  id?: string;
  href?: string;
  linkText?: string;
  meta?: string;
  // Jadikan label sebuah <h2> bila seksi tidak punya judul lain (urutan heading tetap rapi).
  heading?: boolean;
}

const { label, id, href, linkText, meta, heading = false } = Astro.props;
const Label = heading ? 'h2' : 'p';
---

<div class="section-header">
  <Label class="label" id={id}>{label}</Label>
  {
    href && linkText ? (
      <a class="label link" href={href}>
        {linkText} <span aria-hidden="true">→</span>
      </a>
    ) : (
      meta && <p class="label">{meta}</p>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
  }

  .link {
    color: var(--accent);
    text-decoration: none;
  }

  .link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
</style>
