---
import ThemeToggle from './ThemeToggle.astro';
import { langOf, otherLang, routes, useTranslations } from '../i18n/ui';

interface Props {
  // Alamat halaman padanan di bahasa lain, untuk toggle ID / EN.
  alternate: string;
}

const { alternate } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);
const other = otherLang(lang);

const links = [
  { href: routes.films[lang], label: t('nav.films') },
  { href: routes.books[lang], label: t('nav.books') },
  { href: routes.notes[lang], label: t('nav.notes') },
  { href: routes.about[lang], label: t('nav.about') },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a href={routes.home[lang]} class="brand">Iman Setia</a>
    <div class="tools">
      <nav aria-label={t('nav.label')}>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="lang" role="group" aria-label={t('lang.label')}>
        {
          (['id', 'en'] as const).map((code, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {code === lang ? (
                <span class="current" aria-current="true" lang={code}>
                  {code.toUpperCase()}
                </span>
              ) : (
                <a href={alternate} hreflang={other} lang={code}>
                  {code.toUpperCase()}
                </a>
              )}
            </>
          ))
        }
      </div>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 20px;
  }

  .brand {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 26px;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0;
    list-style: none;
  }

  nav a,
  .lang {
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
  }

  .lang {
    display: flex;
    gap: 6px;
    color: var(--muted);
  }

  .lang .current {
    color: var(--ink);
    font-weight: 500;
  }

  .lang a {
    color: var(--accent);
    text-decoration: none;
  }

  .lang a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }
</style>
