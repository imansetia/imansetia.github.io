---
import ThemeToggle from './ThemeToggle.astro';

// Halaman-halaman ini baru dibuat di Tahap 4.
const links = [
  { href: '/tontonan/', label: 'Tontonan' },
  { href: '/bacaan/', label: 'Bacaan' },
  { href: '/catatan/', label: 'Catatan' },
  { href: '/tentang/', label: 'Tentang' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand">Iman Setia</a>
    <div class="tools">
      <nav aria-label="Navigasi utama">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 20px;
  }

  .brand {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 26px;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
