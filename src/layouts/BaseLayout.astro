---
// Kerangka semua halaman: <head>, Header, isi halaman, Footer.
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langOf, otherLang, useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  // Alamat halaman padanan di bahasa lain (untuk toggle ID / EN dan hreflang).
  alternate: string;
}

const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t('site.description'), alternate } = Astro.props;

const fullTitle = title ? `${title} — Iman Setia` : 'Iman Setia';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = new URL(alternate, Astro.site);
// x-default: versi Inggris, bahasa utama situs.
const enUrl = lang === 'en' ? canonical : alternateUrl;
// Gambar pratinjau dibuat oleh scripts/make-images.mjs, satu per bahasa.
const ogImage = new URL(`/og-${lang}.jpg`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang(lang)} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Pratinjau saat link dibagikan (Open Graph). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Iman Setia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.alt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <!-- Tema default terang. Pasang tema gelap tersimpan sebelum halaman tampil,
         supaya tidak berkedip. Tema sistem (prefers-color-scheme) sengaja diabaikan. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
  </head>
  <body>
    <Header alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
